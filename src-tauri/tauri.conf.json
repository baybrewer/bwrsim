{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BWRX-300 Simulator",
  "version": "0.1.0",
  "identifier": "io.github.baybrewer.bwrx300sim",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm --prefix ui run dev",
    "beforeBuildCommand": "npm --prefix ui run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "BWRX-300 Control Room",
        "width": 1600,
        "height": 900,
        "minWidth": 1280,
        "minHeight": 720,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
